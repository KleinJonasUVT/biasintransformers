        <mxCell id="178" value="&lt;div&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;&lt;b&gt;Optimizer: &lt;/b&gt;Adam with&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;β&lt;sub&gt;1&lt;/sub&gt; = 0.9, β&lt;sub&gt;2&lt;/sub&gt; = 0.999 , and a learning rate of&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;caret-color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;1e-4.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; caret-color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Weight decay:&lt;/b&gt;&lt;span style=&quot;background-color: transparent; caret-color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;0.01&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;caret-color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;&lt;b&gt;Linear learning rate schedule:&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;caret-color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;with warm-up over the first 10,000 steps was used.&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontSize=10;" parent="1" vertex="1">
